type Query {
  me: User
  portfolio(id: ID!): Portfolio
}

type Mutation {
  createUser(input: NewUser!): User!
}

type User {
  id: ID!
  username: String!
  email: String!
}

type Portfolio {
  id: ID!
  userId: ID!
  name: String!
  holdings: [Holding!]!
}

type Holding {
  symbol: String!
  quantity: Float!
  value: Float!
}

input NewUser {
  username: String!
  email: String!
}
