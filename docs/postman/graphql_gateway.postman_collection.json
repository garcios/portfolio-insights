                {
                    "name": "Get Type Details - User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetUserType {\n  __type(name: \"User\") {\n    name\n    kind\n    fields {\n      name\n      type {\n        name\n        kind\n      }\n    }\n  }\n}",
                                "variables": ""
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Introspection query to get detailed information about the User type."
                    },
                    "response": []
                },
                {
                    "name": "Get Type Details - Portfolio",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetPortfolioType {\n  __type(name: \"Portfolio\") {\n    name\n    kind\n    fields {\n      name\n      type {\n        name\n        kind\n        ofType {\n          name\n          kind\n        }\n      }\n    }\n  }\n}",
                                "variables": ""
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Introspection query to get detailed information about the Portfolio type, including nested types."
                    },
                    "response": []
                }
            ],
            "description": "GraphQL introspection queries to explore the schema structure and available operations"
        },
        {
            "name": "Error Handling Examples",
            "item": [
                {
                    "name": "Query with Missing Required Variable",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetPortfolio($id: ID!) {\n  portfolio(id: $id) {\n    id\n    name\n  }\n}",
                                "variables": "{}"
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Example of a validation error - missing required variable 'id'. This will return a GraphQL error response."
                    },
                    "response": []
                },
                {
                    "name": "Query with Invalid Field",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetUser {\n  me {\n    id\n    username\n    invalidField\n  }\n}",
                                "variables": ""
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Example of a schema validation error - requesting a field that doesn't exist on the User type."
                    },
                    "response": []
                },
                {
                    "name": "Mutation with Invalid Input",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation CreateUser($input: NewUser!) {\n  createUser(input: $input) {\n    id\n    username\n    email\n  }\n}",
                                "variables": "{\n  \"input\": {\n    \"username\": \"testuser\"\n  }\n}"
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Example of input validation error - missing required 'email' field in NewUser input."
                    },
                    "response": []
