                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetMutationFields {\n  __schema {\n    mutationType {\n      name\n      fields {\n        name\n        description\n        type {\n          name\n          kind\n        }\n      }\n    }\n  }\n}",
                                "variables": ""
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Introspection query to discover all available mutation operations."
                    },
                    "response": []
