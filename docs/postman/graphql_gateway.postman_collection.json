{
    "info": {
        "_postman_id": "portfolio-insights-graphql",
        "name": "Portfolio Insights - GraphQL Gateway",
        "description": "Collection for querying the GraphQL Gateway API. This gateway provides a unified interface to all backend microservices.\n\n**Base URL**: http://localhost:8080\n**GraphQL Endpoint**: /query\n**Playground**: /\n\n**Available Operations**:\n- Queries: me, portfolio\n- Mutations: createUser",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Queries",
            "item": [
                {
                    "name": "Get Current User (me)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetCurrentUser {\n  me {\n    id\n    username\n    email\n  }\n}",
                                "variables": ""
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Retrieves the currently authenticated user's information including ID, username, and email."
                    },
                    "response": []
                },
                {
                    "name": "Get Portfolio by ID",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetPortfolio($id: ID!) {\n  portfolio(id: $id) {\n    id\n    userId\n    name\n    holdings {\n      symbol\n      quantity\n      value\n    }\n  }\n}",
                                "variables": "{\n  \"id\": \"portfolio-123\"\n}"
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Retrieves a specific portfolio by ID, including all holdings with their symbols, quantities, and values."
                    },
                    "response": []
                },
                {
                    "name": "Get Portfolio with Minimal Fields",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetPortfolioMinimal($id: ID!) {\n  portfolio(id: $id) {\n    id\n    name\n  }\n}",
                                "variables": "{\n  \"id\": \"portfolio-123\"\n}"
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Retrieves only the ID and name of a portfolio, demonstrating GraphQL's ability to request only specific fields."
                    },
                    "response": []
                },
                {
                    "name": "Get User and Portfolio Combined",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetUserAndPortfolio($portfolioId: ID!) {\n  me {\n    id\n    username\n    email\n  }\n  portfolio(id: $portfolioId) {\n    id\n    userId\n    name\n    holdings {\n      symbol\n      quantity\n      value\n    }\n  }\n}",
                                "variables": "{\n  \"portfolioId\": \"portfolio-123\"\n}"
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Demonstrates querying multiple root fields in a single request - fetches both the current user and a specific portfolio."
                    },
                    "response": []
                }
            ],
            "description": "GraphQL query operations for retrieving data"
        },
        {
            "name": "Mutations",
            "item": [
                {
                    "name": "Create User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation CreateUser($input: NewUser!) {\n  createUser(input: $input) {\n    id\n    username\n    email\n  }\n}",
                                "variables": "{\n  \"input\": {\n    \"username\": \"johndoe\",\n    \"email\": \"john.doe@example.com\"\n  }\n}"
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Creates a new user with the provided username and email. Returns the created user's ID, username, and email."
                    },
                    "response": []
                },
                {
                    "name": "Create User - Minimal Response",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation CreateUser($input: NewUser!) {\n  createUser(input: $input) {\n    id\n  }\n}",
                                "variables": "{\n  \"input\": {\n    \"username\": \"janedoe\",\n    \"email\": \"jane.doe@example.com\"\n  }\n}"
                            }
                        },
                        "url": {
                            "raw": "{{gateway_url}}/query",
                            "host": [
                                "{{gateway_url}}"
                            ],
                            "path": [
                                "query"
                            ]
                        },
                        "description": "Creates a new user but only requests the ID in the response, demonstrating selective field retrieval in mutations."
                    },
                    "response": []
                }
            ],
            "description": "GraphQL mutation operations for modifying data"
        },
        {
            "name": "Introspection",
            "item": [
